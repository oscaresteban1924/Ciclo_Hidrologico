{
  "name": "ciclo-hidrologico",
  "private": true,
  "version": "1.0.0",
  "description": "Aplicación educativa interactiva sobre el ciclo hidrológico para niñas y niños de 8 a 12 años.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:city": "tsx tests/city/sim.test.ts",
    "test:quality": "tsx tests/quality/model.test.ts",
    "test:canals": "tsx tests/canals/hydraulics.test.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
